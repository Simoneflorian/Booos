# Kopiere diese Datei zu ".env" und trage deinen Schlüssel ein, um den KI-Modus zu aktivieren.
# Ohne Schlüssel laufen alle lokalen Funktionen trotzdem.

# API-Schlüssel von https://console.anthropic.com (Bereich "API Keys")
ANTHROPIC_API_KEY=

# Optional: anderes Claude-Modell (Standard: claude-opus-5-5)
# KI_MODELL=claude-opus-5-5

# Optional: anderer Port (Standard: 3000)
# PORT=3000
