<mj-attributes>
  <mj-all font-family="Arial, Helvetica, sans-serif" />
  <mj-body background-color="[[farbe_hintergrund]]" width="600px" />
  <mj-section background-color="#FFFFFF" padding="0 28px" />
  <mj-column padding="0" />
  <mj-text font-size="16px" line-height="1.6" color="#2B2B2B" padding="8px 0" />
  <mj-button background-color="[[farbe_akzent]]" color="[[farbe_button_text]]" font-size="17px" font-weight="700" border-radius="6px" inner-padding="15px 30px" padding="18px 0" align="left" />
  <mj-image padding="0" />
  <mj-class name="headline" css-class="headline" font-size="24px" line-height="1.3" font-weight="700" color="[[farbe_primaer]]" padding="28px 0 8px" />
  <mj-class name="box" css-class="box" container-background-color="#FFF4EA" padding="16px 20px" />
  <mj-class name="klein" font-size="14px" line-height="1.5" color="#555555" />
</mj-attributes>
<mj-style inline="inline">
  a { color: [[farbe_primaer]]; }
  .box div { border-left: 4px solid [[farbe_akzent]]; padding-left: 14px; }
  .liste li { margin-bottom: 6px; }
</mj-style>
<mj-style>
  @media only screen and (max-width: 480px) {
    .headline div { font-size: 22px !important; }
  }
</mj-style>
